# ── PaiPalace environment ──────────────────────────────────────────────
# Copy to server/.env and client/.env as noted below.

# ===== SERVER (server/.env) =====
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL="file:./dev.db"

# AI agents — set a real key for live Claude decisions; blank = simulated engine
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

CLIENT_ORIGIN=http://localhost:5173

# Solana (mainnet). Use a real RPC (Helius/QuickNode) for production reliability.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Treasury that receives deposits and sends withdrawals.
# Generate one: node -e "const {Keypair}=require('@solana/web3.js');const b=require('bs58');const k=Keypair.generate();console.log('addr',k.publicKey.toBase58());console.log('secret',b.default.encode(k.secretKey))"
TREASURY_ADDRESS=
TREASURY_SECRET=   # base58 secret of the treasury (server-only; required for withdrawals)

# First user with this email (or the very first user) becomes the platform admin
ADMIN_EMAIL=

# ===== CLIENT (client/.env) =====
VITE_API_URL=http://localhost:4000
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VITE_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
VITE_TREASURY_ADDRESS=   # same treasury public address as above
