# ── PaiPalace environment ──────────────────────────────────────────────
# Copy to server/.env and client/.env as noted below.

# ===== SERVER (server/.env) =====
PORT=4000
# JWT signing secret — CHANGE THIS in production
JWT_SECRET=change-me-to-a-long-random-string
# SQLite by default; swap for a Postgres URL in production
DATABASE_URL="file:./dev.db"

# Anthropic API key — enables REAL Claude-powered agent decisions.
# Leave blank to use the built-in simulated strategy engine (no key required).
ANTHROPIC_API_KEY=
# Model used for agent decisions (see https://docs.claude.com)
ANTHROPIC_MODEL=claude-opus-4-8

# CORS origin (frontend dev server)
CLIENT_ORIGIN=http://localhost:5173

# ===== CLIENT (client/.env) =====
# Backend base URL
VITE_API_URL=http://localhost:4000
# Target EVM chain id. 84532 = Base Sepolia (TESTNET, default & recommended).
# 8453 = Base mainnet (real funds — requires audited contracts + a license).
VITE_CHAIN_ID=84532
# Deployed PaiPalaceStaking contract address (optional; testnet)
VITE_STAKING_CONTRACT=
